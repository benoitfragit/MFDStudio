# Check the actual optional DLL copies; no staging repair may hide a missing copy.
function(expect_same source destination)
    if(NOT EXISTS "${destination}")
        message(FATAL_ERROR "Missing LEVEL 1 DLL: ${destination}")
    endif()
    file(SHA256 "${source}" source_hash)
    file(SHA256 "${destination}" destination_hash)
    if(NOT source_hash STREQUAL destination_hash)
        message(FATAL_ERROR "Stale LEVEL 1 DLL: ${destination}")
    endif()
endfunction()
expect_same("${RUNTIME_DLL}" "${WINDOW_DIR}/mfd_containers_api1.dll")
expect_same("${RUNTIME_DLL}" "${EDITOR_DIR}/mfd_containers_api1.dll")
expect_same("${EDITOR_DLL}" "${EDITOR_DIR}/mfd_editor_containers_api1.dll")
