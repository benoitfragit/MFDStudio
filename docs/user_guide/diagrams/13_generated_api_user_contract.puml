@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam packageStyle rectangle
skinparam ArrowColor #355070
skinparam ArrowThickness 1.1
skinparam rectangle {
  RoundCorner 12
  BorderColor #355070
  FontColor #1F2933
}
top to bottom direction

rectangle "Generated UI root \n Window() \n Run() / Initialize() \n BuildBatch() / BuildResetBatch() \n BuildCommandBatch(sequence) \n SubmitLatest() / SubmitReset() \n ApplyFeedback() \n PollFeedback()" as UiRoot #D9EDFF
rectangle "Page wrappers \n Name() \n GeneratedId() \n MappingHash() \n IsActive()" as Pages #EAF4F4
rectangle "Static reticle wrappers \n SetVisible() \n SetPosition() \n SetRotationDegrees() \n SetColor() \n SetBlinkType()" as Reticles #E9F5DB
rectangle "Primitive handles \n TextHandle / LineHandle / CircleHandle / ... \n SetText() / SetScale() / SetPoints() / ..." as Primitives #E9F5DB
rectangle "Dynamic reticle sets \n Create() \n Remove() \n SetVisible()" as DynamicSets #FFF3D6
rectangle "Dynamic reticle instances \n runtimeReticleId hidden from user code \n IsAlive() / IsStrobeCaptured()" as DynamicInstances #FFF3D6
rectangle "Page strobe handle \n SetActive() \n SetPosition()" as Strobe #FDE2E4
rectangle "CommandBatch / UserCommand staging" as Batches #FFE5EC
rectangle "CommandClient / LatestBatchPublisher" as Transport #FFE5EC
rectangle "Feedback channel \n IExchangeChannel + FeedbackTransport" as Feedback #F3E8FF

UiRoot --> Pages
Pages --> Reticles
Reticles --> Primitives
Pages --> DynamicSets
DynamicSets --> DynamicInstances
Pages --> Strobe
UiRoot --> Batches
Batches --> Transport
Feedback --> UiRoot

note bottom of UiRoot
This is the preferred user-facing contract for one authored window.
User code manipulates typed handles, then publishes batches through
CommandClient or LatestBatchPublisher without dealing with transport ids directly.
end note
@enduml
