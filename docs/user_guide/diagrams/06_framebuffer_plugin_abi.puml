@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam ArrowColor #7F5539
skinparam ArrowThickness 1.2
skinparam activity {
  DiamondBorderColor #7F5539
  DiamondBackgroundColor #FFF3D6
  BorderColor #7F5539
  BackgroundColor #FDEBD3
  FontColor #1F2933
}

start
:mfd_window loads plugin.dll;
:Search exported symbol\nMfdGetWindowFramebufferPluginApi;
:Fill MfdWindowFramebufferPluginApi\nstruct_size / info /\nrequested_pixel_format / callbacks;
:Allocate plugin_context;
:init(...);
:submit_frame(frame)\nwidth / height / pixels\npixel_bytes / row_stride\nRGBA32 or BGRA32;
:Copy or hand off pixels into\nplugin-owned memory;
:close();
:destroy();
stop

note right
Stable C ABI only:
- no STL across the boundary
- no exceptions across the boundary
- no shared graphics objects
end note
@enduml
