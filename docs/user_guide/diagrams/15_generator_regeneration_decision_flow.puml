@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam activity {
  DiamondBorderColor #6D597A
  DiamondBackgroundColor #FFF3D6
  BorderColor #6D597A
  BackgroundColor #F3E8FF
  FontColor #1F2933
  ArrowColor #6D597A
}

start
:Author edits window, page,\nor reticle template JSON;

:CMake configure runs\n`generate_ui.py --print-inputs`;
:generator lists real inputs\nwindow + pages + templates;
:ClientApiGenerator.cmake records them\nin CMAKE_CONFIGURE_DEPENDS;

if (Did the authoring change\nmodify the client-visible\ntransport surface?) then (yes)
  :Regenerate Ui.h / Ui.cpp /\n<window>.generated.map;
  :Rebuild the client target;
  :Launch runtime and client\nfrom the same generated revision;
else (no)
  :Rebuild only what changed;
endif

if (Generated client and runtime\nuse different mappingHash values?) then (yes)
  :First id-based batch is rejected;\nregenerate and rebuild again;
else (no)
  :Generated ids and mappingHash\nstay compatible;
endif

stop
@enduml
