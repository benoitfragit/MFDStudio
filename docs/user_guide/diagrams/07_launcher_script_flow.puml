@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam activity {
  DiamondBorderColor #355070
  DiamondBackgroundColor #FFF3D6
  BorderColor #355070
  BackgroundColor #EAF4F4
  FontColor #1F2933
  ArrowColor #355070
}

start
:Start-MfdWindow.bat receives\nwindow.json + options;
if (window provided?) then (yes)
else (no)
  :display script usage;
  stop
endif

:parse --runtime-dir,\n--framebuffer-plugin,\n--wait, and remaining args;

if (explicit runtime-dir?) then (yes)
  :validate mfd_window.exe\nin the provided folder;
else (no)
  if (mfd_window.exe next to the script?) then (yes)
    :use this runtime;
  else (no)
    :search under _Exec\\<toolset>\\<platform>\\<config>;
  endif
endif

:resolve window.json path;
if (explicit plugin or\nMFD_DEFAULT_FRAMEBUFFER_PLUGIN?) then (yes)
  :resolve plugin DLL path;
endif

:build command line\nmfd_window --window ...\n[--framebuffer-plugin ...];

if (--wait or --help?) then (yes)
  :synchronous call;
else (no)
  :start detached process;
endif

stop
@enduml
