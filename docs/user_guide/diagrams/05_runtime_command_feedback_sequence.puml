@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam sequence {
  ArrowColor #264653
  LifeLineBorderColor #264653
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #264653
  ParticipantBackgroundColor #E9F5DB
}

actor "Client loop" as Client
participant "Generated UI root" as Ui
participant "CommandClient" as Cmd
participant "UDP transport\nIExchangeChannel" as Udp
participant "UdpRuntimeBridge" as Bridge
participant "CommandProcessor" as Processor
participant "SceneRegistry + renderer" as Render
participant "Feedback sender" as Feedback

Client -> Ui : mutate pages / reticles /\nprimitives / strobe
Client -> Ui : BuildCommandBatch(sequence)
Ui --> Client : CommandBatch
Client -> Cmd : SendBatch(batch)
Cmd -> Cmd : NormalizeBatchForTransport()
alt batch exceeds max payload
  Cmd -> Cmd : split payloads while preserving\nsequence + mappingHash
end
Cmd -> Udp : serialize envelopes and send
Udp -> Bridge : UDP packets
Render -> Bridge : drain queued commands\nat frame start
Bridge -> Processor : up to kMaxCommandsPerFrame
Processor -> Render : mutate scene registry
Render -> Feedback : publish active page /\nstrobe capture feedback
Feedback -> Client : UDP feedback payloads
Client -> Ui : PollFeedback(...)
Ui --> Client : IsActive() /\nIsStrobeCaptured()
@enduml
