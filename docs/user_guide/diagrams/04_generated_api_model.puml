@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam ArrowColor #6D597A
skinparam ArrowThickness 1.2
skinparam activity {
  DiamondBorderColor #6D597A
  DiamondBackgroundColor #F4ECFF
  BorderColor #6D597A
  BackgroundColor #F8FAFC
  FontColor #1F2933
}

start
:Window JSON + page JSON +\nreticle templates;
:generate_ui.py;
fork
  :Emit Ui.h / Ui.cpp;
fork again
  :Emit .generated.map\nids + mappingHash;
end fork
:Generated UI root\nWindow() / BuildBatch()\nBuildCommandBatch();
:Generated page wrappers\nName() / GeneratedId()\nMappingHash() / IsActive();
:Static reticle wrappers and\nprimitive handles;
:Dynamic set + dynamic reticle\nCreate() / Remove()\nIsStrobeCaptured();
:CommandClient sends\nID + mappingHash batch;
:mfd_window applies commands;
:Runtime feedback updates\nIsActive() and IsStrobeCaptured();
stop

note right
The generated layer hides transport ids
from business code while keeping the
runtime compatibility hash explicit.
end note
@enduml
