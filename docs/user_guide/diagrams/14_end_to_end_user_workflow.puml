@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam ArrowColor #1565C0
skinparam ArrowThickness 1.2
skinparam activity {
  DiamondBorderColor #1565C0
  DiamondBackgroundColor #DCEBFF
  BorderColor #1565C0
  BackgroundColor #F8FAFC
  FontColor #1F2933
}

start
:Author\nDesign window and pages\nin mfd_editor;
:Author\nSave assets under assets/;
:Integrator\nRegenerate Ui.h / Ui.cpp\nand .generated.map;
:Integrator\nBuild the product client;
:Operator\nLaunch mfd_window;
:Integrator\nRun the external client and\npublish live batches;
:Operator\nObserve active page,\nstrobe feedback, and framebuffer;
stop

note right
Role split:
- author = visual model
- integrator = live state publication
- operator = runtime execution
end note
@enduml
