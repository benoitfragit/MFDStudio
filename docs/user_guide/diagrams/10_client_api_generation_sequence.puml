@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam sequence {
  ArrowColor #6D597A
  LifeLineBorderColor #6D597A
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #6D597A
  ParticipantBackgroundColor #F3E8FF
}

participant "CMake configure" as CMake
participant "ClientApiGenerator.cmake" as Macro
participant "Python3" as Python
participant "generate_ui.py" as Generator
participant "Authoring assets   \n   window/pages/reticles" as Assets
participant "CMake directory state" as DirState
participant "Generated outputs   \n   Ui.h / Ui.cpp / .generated.map" as Outputs

CMake -> Macro : client_api_generate_ui(...)
Macro -> Python : generate_ui.py --window-json ... --print-inputs
Python -> Generator : launch input scan
Generator -> Assets : load window JSON \n and all referenced assets
Generator --> Macro : newline-separated input paths
Macro -> DirState : append generator script \n and input paths to CMAKE_CONFIGURE_DEPENDS
Macro -> Python : generate_ui.py --force-overwrite \n --namespace ... --output-header ... \n --output-source ... [--output-map]
Python -> Generator : launch real generation
Generator -> Assets : rebuild canonical authoring model
Generator -> Outputs : write generated header
Generator -> Outputs : write generated source
opt OUTPUT_MAP provided
  Generator -> Outputs : write <window>.generated.map
end
Generator --> Macro : success / fatal error
Macro -> CMake : mark outputs GENERATED

note over Generator, Outputs
The same canonical mapping payload produces both
the generated mappingHash compiled into the UI layer
and the companion .generated.map file.
end note
@enduml
