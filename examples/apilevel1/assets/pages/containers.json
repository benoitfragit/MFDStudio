{
  "name": "Containers",
  "title": "Nested API LEVEL 1 containers",
  "bg": "#050A0EFF",
  "layers": [{"id": "default"}],
  "staticReticles": [],
  "containers": [
    {
      "id": "main_panel",
      "name": "Main panel",
      "type": "canvas",
      "position": [0.0, 0.0],
      "size": [1.75, 1.65],
      "minimumSize": [0.5, 0.5],
      "exposed": true,
      "padding": 0.05,
      "appearance": {
        "backgroundVisible": true,
        "backgroundColor": [7, 18, 26, 230],
        "borderVisible": true,
        "borderColor": [83, 188, 190, 255],
        "borderThickness": 0.008,
        "cornerRadius": 0.025
      },
      "children": [
        {"id": "status_grid", "resizeMode": "proportional", "renderOrder": 0},
        {"id": "scroll_panel", "resizeMode": "proportional", "renderOrder": 1}
      ]
    },
    {
      "id": "status_grid",
      "name": "Status grid",
      "type": "grid",
      "position": [0.0, 0.43],
      "size": [1.5, 0.55],
      "padding": 0.025,
      "spacing": 0.035,
      "grid": {"rows": 1, "columns": 2},
      "children": [
        {"id": "left_column", "row": 0, "column": 0, "horizontalAlignment": "stretch", "verticalAlignment": "stretch"},
        {"id": "right_column", "row": 0, "column": 1, "horizontalAlignment": "stretch", "verticalAlignment": "stretch"}
      ]
    },
    {
      "id": "left_column",
      "name": "Left linear column",
      "type": "linear",
      "size": [0.6, 0.4],
      "orientation": "vertical",
      "alignment": "stretch",
      "spacing": 0.02,
      "children": [
        {"id": "left_overlay"},
        {"id": "left_footer"}
      ]
    },
    {
      "id": "right_column",
      "name": "Right overlay",
      "type": "overlay",
      "size": [0.6, 0.4],
      "appearance": {
        "backgroundVisible": true,
        "backgroundColor": [18, 44, 56, 210]
      }
    },
    {
      "id": "left_overlay",
      "name": "Overlay item",
      "type": "overlay",
      "size": [0.5, 0.16],
      "appearance": {
        "backgroundVisible": true,
        "backgroundColor": [28, 72, 82, 230]
      }
    },
    {
      "id": "left_footer",
      "name": "Linear footer",
      "type": "canvas",
      "size": [0.5, 0.16],
      "appearance": {
        "borderVisible": true,
        "borderColor": [255, 193, 92, 255],
        "borderThickness": 0.006
      }
    },
    {
      "id": "scroll_panel",
      "name": "Scrollable panel",
      "type": "canvas",
      "position": [0.0, -0.43],
      "size": [1.5, 0.55],
      "padding": [0.03, 0.03, 0.06, 0.03],
      "scrolling": {
        "horizontal": "disabled",
        "vertical": "automatic",
        "offset": [0.0, 0.0],
        "clipContent": true,
        "appearance": {
          "trackColor": [15, 34, 42, 220],
          "thumbColor": [86, 174, 178, 255],
          "hoverColor": [122, 218, 221, 255],
          "activeColor": [255, 193, 92, 255],
          "thickness": 0.025,
          "cornerRadius": 0.008,
          "minimumThumbSize": 0.08,
          "margins": [0.0, 0.01, 0.005, 0.01]
        }
      },
      "children": [
        {"id": "scroll_content", "renderOrder": 0}
      ]
    },
    {
      "id": "scroll_content",
      "name": "Overflowing content",
      "type": "linear",
      "position": [0.0, -0.35],
      "size": [1.28, 1.2],
      "orientation": "vertical",
      "alignment": "stretch",
      "appearance": {
        "backgroundVisible": true,
        "backgroundColor": [13, 39, 48, 220],
        "borderVisible": true,
        "borderColor": [60, 128, 140, 255],
        "borderThickness": 0.004
      }
    }
  ]
}
