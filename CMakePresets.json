{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "toolset": "v142",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "MFD_BUILD_DEMO": "ON"
      }
    },
    {
      "name": "vs2022-base-no-tests",
      "hidden": true,
      "inherits": "vs2022-base",
      "cacheVariables": {
        "MFD_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "vs2022-x64",
      "inherits": "vs2022-base",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "vs2022-x64-no-tests",
      "inherits": "vs2022-base-no-tests",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "vs2022-win32",
      "inherits": "vs2022-base",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      }
    },
    {
      "name": "vs2022-win32-no-tests",
      "inherits": "vs2022-base-no-tests",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      }
    },
    {
      "name": "clang-fuzz-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MFD_BUILD_DEMO": "OFF",
        "MFD_BUILD_TESTS": "OFF",
        "MFD_ENABLE_FUZZING": "ON",
        "MFD_MSVC_RUNTIME": "dll"
      }
    },
    {
      "name": "clang-fuzz-x64",
      "inherits": "clang-fuzz-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-base",
      "hidden": true,
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "$penv{NUMBER_OF_PROCESSORS}"
      }
    },
    {
      "name": "debug-x64",
      "inherits": "build-base",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "release-x64",
      "inherits": "build-base",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "debug-x64-no-tests",
      "inherits": "build-base",
      "configurePreset": "vs2022-x64-no-tests",
      "configuration": "Debug"
    },
    {
      "name": "release-x64-no-tests",
      "inherits": "build-base",
      "configurePreset": "vs2022-x64-no-tests",
      "configuration": "Release"
    },
    {
      "name": "debug-win32",
      "inherits": "build-base",
      "configurePreset": "vs2022-win32",
      "configuration": "Debug"
    },
    {
      "name": "release-win32",
      "inherits": "build-base",
      "configurePreset": "vs2022-win32",
      "configuration": "Release"
    },
    {
      "name": "debug-win32-no-tests",
      "inherits": "build-base",
      "configurePreset": "vs2022-win32-no-tests",
      "configuration": "Debug"
    },
    {
      "name": "release-win32-no-tests",
      "inherits": "build-base",
      "configurePreset": "vs2022-win32-no-tests",
      "configuration": "Release"
    },
    {
      "name": "fuzz-x64",
      "inherits": "build-base",
      "configurePreset": "clang-fuzz-x64"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug-x64",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-debug-win32",
      "configurePreset": "vs2022-win32",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-debug-win32-ci",
      "inherits": "test-debug-win32",
      "filter": {
        "exclude": {
          "name": "CanvasCircleStrokeRenderTests\\.DegenerateSolidCircleDrawsNothing|CanvasCircleStrokeRenderTests\\.DashedCircleRendersLessStrokeCoverageThanSolidCircle|CanvasCircleStrokeRenderTests\\.AnisotropicFilledCircleUsesTheSameTransformAsItsOutline|CanvasRingRenderTests\\..*|CanvasClippingCallbackRenderTests\\..*|CanvasClippingRenderTests\\..*|CanvasTextRenderTests\\..*|RenderResourceLifetimeTests\\..*|OffscreenSurfaceTests\\..*"
        }
      }
    }
  ]
}
