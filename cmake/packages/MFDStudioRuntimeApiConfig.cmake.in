@PACKAGE_INIT@

set(_mfdstudio_runtime_api_root "${CMAKE_CURRENT_LIST_DIR}/..")
get_filename_component(_mfdstudio_runtime_api_root "${_mfdstudio_runtime_api_root}" ABSOLUTE)

if(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(_mfdstudio_runtime_api_arch "x64")
else()
    set(_mfdstudio_runtime_api_arch "win32")
endif()

set(MFDStudioRuntimeApi_INCLUDE_DIR "${_mfdstudio_runtime_api_root}/include")
set(MFDStudioRuntimeApi_LIBRARY_DIR
    "${_mfdstudio_runtime_api_root}/libs/@MFD_PACKAGE_TOOLSET@/${_mfdstudio_runtime_api_arch}")
set(MFDStudioRuntimeApi_CMAKE_DIR "${_mfdstudio_runtime_api_root}/cmake")

set(_mfdstudio_runtime_api_debug_implib
    "${MFDStudioRuntimeApi_LIBRARY_DIR}/Debug/mfd_runtime_api.lib")
set(_mfdstudio_runtime_api_release_implib
    "${MFDStudioRuntimeApi_LIBRARY_DIR}/Release/mfd_runtime_api.lib")
set(_mfdstudio_runtime_api_imported_configs "")

if(NOT EXISTS "${MFDStudioRuntimeApi_INCLUDE_DIR}")
    message(FATAL_ERROR "MFDStudioRuntimeApi include directory not found: ${MFDStudioRuntimeApi_INCLUDE_DIR}")
endif()

if(EXISTS "${_mfdstudio_runtime_api_debug_implib}")
    list(APPEND _mfdstudio_runtime_api_imported_configs Debug)
endif()

if(EXISTS "${_mfdstudio_runtime_api_release_implib}")
    list(APPEND _mfdstudio_runtime_api_imported_configs Release)
endif()

if(_mfdstudio_runtime_api_imported_configs STREQUAL "")
    message(FATAL_ERROR
        "MFDStudioRuntimeApi import libraries not found under ${MFDStudioRuntimeApi_LIBRARY_DIR}")
endif()

if(NOT TARGET @MFD_PACKAGE_IMPORTED_TARGET_NAME@)
    add_library(@MFD_PACKAGE_IMPORTED_TARGET_NAME@ SHARED IMPORTED)
    set_target_properties(@MFD_PACKAGE_IMPORTED_TARGET_NAME@ PROPERTIES
        IMPORTED_CONFIGURATIONS "${_mfdstudio_runtime_api_imported_configs}"
        INTERFACE_COMPILE_FEATURES "cxx_std_17"
        INTERFACE_INCLUDE_DIRECTORIES "${MFDStudioRuntimeApi_INCLUDE_DIR}")
    set_property(TARGET @MFD_PACKAGE_IMPORTED_TARGET_NAME@
        PROPERTY INTERFACE_COMPILE_DEFINITIONS
            "MFD_RUNTIME_API_DLL;NOMINMAX;WIN32_LEAN_AND_MEAN")
    if(EXISTS "${_mfdstudio_runtime_api_debug_implib}")
        set_property(TARGET @MFD_PACKAGE_IMPORTED_TARGET_NAME@
            PROPERTY IMPORTED_IMPLIB_DEBUG
                "${_mfdstudio_runtime_api_debug_implib}")
    endif()
    if(EXISTS "${_mfdstudio_runtime_api_release_implib}")
        set_property(TARGET @MFD_PACKAGE_IMPORTED_TARGET_NAME@
            PROPERTY IMPORTED_IMPLIB_RELEASE
                "${_mfdstudio_runtime_api_release_implib}")
        set_property(TARGET @MFD_PACKAGE_IMPORTED_TARGET_NAME@
            PROPERTY MAP_IMPORTED_CONFIG_MINSIZEREL Release)
        set_property(TARGET @MFD_PACKAGE_IMPORTED_TARGET_NAME@
            PROPERTY MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release)
    endif()
endif()

set(MFDStudioRuntimeApi_INCLUDE_DIRS "${MFDStudioRuntimeApi_INCLUDE_DIR}")
