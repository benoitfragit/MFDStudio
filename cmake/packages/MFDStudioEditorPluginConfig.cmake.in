@PACKAGE_INIT@

set(_mfdstudio_editor_plugin_root "${CMAKE_CURRENT_LIST_DIR}/..")
get_filename_component(_mfdstudio_editor_plugin_root "${_mfdstudio_editor_plugin_root}" ABSOLUTE)

set(MFDStudioEditorPlugin_INCLUDE_DIR "${_mfdstudio_editor_plugin_root}/include")

if(NOT EXISTS "${MFDStudioEditorPlugin_INCLUDE_DIR}")
    message(FATAL_ERROR "MFDStudioEditorPlugin include directory not found: ${MFDStudioEditorPlugin_INCLUDE_DIR}")
endif()

if(NOT TARGET @MFD_PACKAGE_IMPORTED_TARGET_NAME@)
    add_library(@MFD_PACKAGE_IMPORTED_TARGET_NAME@ INTERFACE IMPORTED)
    set_target_properties(@MFD_PACKAGE_IMPORTED_TARGET_NAME@ PROPERTIES
        INTERFACE_COMPILE_FEATURES "cxx_std_17"
        INTERFACE_INCLUDE_DIRECTORIES "${MFDStudioEditorPlugin_INCLUDE_DIR}")
endif()

set(MFDStudioEditorPlugin_INCLUDE_DIRS "${MFDStudioEditorPlugin_INCLUDE_DIR}")
